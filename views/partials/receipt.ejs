<%# Vue-driven order receipt card. Requires `order`, `statusMap`, `itemImage(item)`, `formatDate()` in scope. %>
<article class="bg-card rounded-[18px] border border-line shadow-[0_24px_60px_-30px_rgba(30,38,32,.35)] relative">
  <header class="px-6 md:px-10 pt-7 md:pt-9 pb-6 md:pb-7 flex flex-col gap-4">
    <div class="flex items-center justify-between">
      <span class="font-label font-bold text-[10.5px] tracking-[0.24em] text-ink-muted">ORDER RECEIPT</span>
      <span class="pill" :class="statusMap[order.status]?.cls || 'pill-pending'">{{ statusMap[order.status]?.label || order.status }}</span>
    </div>
    <div>
      <p class="text-[12.5px] text-ink-muted">訂單編號</p>
      <p class="font-label font-semibold text-lg md:text-[22px] tracking-[0.02em] mt-1 break-all">{{ order.order_no }}</p>
    </div>
    <div class="flex gap-10 text-sm">
      <div><p class="text-xs text-ink-muted">建立日期</p><p class="font-label font-medium mt-1">{{ formatDate(order.created_at) }}</p></div>
      <div><p class="text-xs text-ink-muted">付款方式</p><p class="font-medium mt-1">綠界 ECPay</p></div>
    </div>
  </header>
  <!-- perforation -->
  <div class="relative h-px border-t border-dashed border-line mx-0">
    <span class="absolute -left-[11px] -top-[11px] w-[22px] h-[22px] rounded-full bg-paper border-r border-line"></span>
    <span class="absolute -right-[11px] -top-[11px] w-[22px] h-[22px] rounded-full bg-paper border-l border-line"></span>
  </div>
  <ul class="px-6 md:px-10 py-3 md:py-4">
    <li v-for="item in order.items" :key="item.id" class="flex items-center gap-4 py-3">
      <div class="relative shrink-0">
        <img v-if="itemImage(item)" :src="itemImage(item)" :alt="item.product_name" class="w-[52px] h-16 md:w-14 md:h-[70px] rounded-md object-cover bg-linen">
        <span v-else class="w-[52px] h-16 md:w-14 md:h-[70px] rounded-md bg-linen grid place-items-center font-serif text-lg text-ink-soft">{{ item.product_name.charAt(0) }}</span>
        <span class="absolute -top-2 -right-2 w-[22px] h-[22px] rounded-full bg-ink text-paper grid place-items-center font-label font-bold text-[10.5px]">{{ item.quantity }}</span>
      </div>
      <div class="flex-1 min-w-0">
        <p class="font-serif font-medium truncate">{{ item.product_name }}</p>
        <p class="font-label font-medium text-xs text-ink-muted mt-1">NT$ {{ item.product_price.toLocaleString() }} × {{ item.quantity }}</p>
      </div>
      <p class="font-label font-semibold text-sm whitespace-nowrap">NT$ {{ (item.product_price * item.quantity).toLocaleString() }}</p>
    </li>
  </ul>
  <footer class="px-6 md:px-10 pb-7 md:pb-9">
    <div class="flex justify-between items-baseline pt-5 border-t border-line">
      <span class="font-serif font-medium text-[17px] md:text-lg">{{ order.status === 'paid' ? '已付金額' : '應付金額' }}</span>
      <span><span class="font-label font-semibold text-xs text-ink-soft mr-1.5">NT$</span><span class="num text-4xl md:text-[44px] leading-none">{{ order.total_amount.toLocaleString() }}</span></span>
    </div>
  </footer>
</article>
