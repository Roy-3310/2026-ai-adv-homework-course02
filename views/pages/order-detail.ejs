<div id="app" data-order-id="<%= orderId %>" data-payment-result="<%= paymentResult %>">
  <div v-if="loading" class="container-x py-14 grid lg:grid-cols-2 gap-16">
    <div class="space-y-6"><div class="h-4 w-40 rounded skeleton"></div><div class="h-28 w-4/5 rounded skeleton"></div><div class="h-14 w-72 rounded-full skeleton"></div></div>
    <div class="h-[520px] rounded-2xl skeleton"></div>
  </div>

  <div v-else-if="!order" class="container-x py-24 text-center">
    <div class="w-40 h-52 arch bg-linen mx-auto mb-8 grid place-items-center display-italic text-3xl text-ink-muted">oops</div>
    <h1 class="font-serif text-2xl mb-3">找不到這筆訂單</h1>
    <a href="/orders" class="btn btn-ink mt-6">回到我的訂單</a>
  </div>

  <template v-else>
    <!-- ================= PAYMENT SUCCESS ================= -->
    <section v-if="isPaid" class="relative overflow-hidden">
      <canvas ref="petalCanvas" class="pointer-events-none absolute inset-x-0 top-0 h-[900px] w-full z-0" aria-hidden="true"></canvas>

      <div class="relative z-10 container-x pt-8 md:pt-10 pb-10 md:pb-14 flex flex-col items-center text-center">
        <div class="w-full md:w-auto" data-intro><%- include('../partials/stepper') %></div>

        <svg class="mt-10 md:mt-14 w-[150px] h-[150px] md:w-[200px] md:h-[200px]" viewBox="0 0 200 200" fill="none" aria-hidden="true">
          <circle class="wreath-ring" cx="100" cy="100" r="72" stroke="#B8975A" stroke-width="1" transform="rotate(-90 100 100)"/>
          <g v-for="(l, i) in wreathLeaves" :key="i" :transform="'rotate(' + l.angle + ' 100 100)'">
            <circle v-if="l.berry" class="wreath-leaf" cx="100" cy="28" r="4.5" :fill="l.color" :style="{ animationDelay: (0.25 + i * 0.045) + 's' }"/>
            <ellipse v-else class="wreath-leaf" cx="100" cy="27" rx="5" ry="12" :fill="l.color" :transform="'rotate(' + l.tilt + ' 100 27)'" :style="{ animationDelay: (0.25 + i * 0.045) + 's' }"/>
          </g>
          <circle class="wreath-core" cx="100" cy="100" r="44" fill="#1E2620"/>
          <path class="wreath-check" d="M82 101l12 12 24-26" stroke="#F5F0E8" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>

        <p class="eyebrow mt-8" data-intro>Payment Received · 付款成功</p>
        <h1 class="font-serif font-medium text-[36px] leading-[1.3] md:text-[60px] mt-5" data-intro>謝謝你，<br class="md:hidden">花已在路上。</h1>
        <p class="text-ink-soft text-[14px] md:text-base leading-[1.9] mt-5 max-w-[620px]" data-intro>
          付款成功！感謝您的購買。訂單通知將寄至 <span class="text-ink font-medium">{{ order.recipient_email }}</span>，花藝師將於今日開始為你配置花束。
        </p>
      </div>

      <div class="relative z-10 container-x pb-24 md:pb-36 grid lg:grid-cols-[560px_560px] justify-center gap-10 lg:gap-20 items-start">
        <div data-reveal><%- include('../partials/receipt') %></div>
        <div class="flex flex-col gap-4 md:gap-5" data-reveal>
          <h2 class="font-serif font-medium text-[19px] md:text-2xl">接下來會發生什麼</h2>
          <div v-for="s in nextSteps" :key="s.n" class="surface rounded-[14px] p-5 md:p-7 flex md:flex-col gap-3.5 group transition-transform duration-700 ease-[cubic-bezier(.22,1,.36,1)] hover:-translate-y-1">
            <div class="flex items-center gap-3"><span class="display-italic text-[26px] md:text-[28px] text-clay leading-none">{{ s.n }}</span>
              <svg class="hidden md:block text-moss" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" v-html="s.icon"></svg></div>
            <div><h3 class="font-serif font-medium text-[15.5px] md:text-lg">{{ s.title }}</h3><p class="text-[13px] text-ink-muted mt-1 leading-[1.7]">{{ s.desc }}</p></div>
          </div>
          <div class="flex flex-col sm:flex-row gap-3 md:gap-4 pt-2">
            <a href="/orders" class="btn btn-ink" data-magnetic>查看我的訂單
              <svg class="btn-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16M14 6l6 6-6 6"/></svg></a>
            <a href="/" class="btn btn-outline">繼續逛逛</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= ORDER CONFIRMED (pending / failed) ================= -->
    <section v-else>
      <div class="container-x pt-8 md:pt-14 md:flex md:justify-end" data-intro><%- include('../partials/stepper') %></div>
      <div class="container-x pt-8 md:pt-12 pb-24 md:pb-36 grid lg:grid-cols-[620fr_540fr] gap-10 lg:gap-[120px] items-start">
        <div class="flex flex-col gap-8 md:gap-10">
          <div>
            <p class="eyebrow" data-intro>{{ order.status === 'failed' ? 'Payment Failed · 付款未完成' : 'Order Confirmed · 訂單已成立' }}</p>
            <h1 class="font-serif font-medium text-[32px] leading-[1.35] md:text-[56px] md:leading-[1.3] mt-5" data-intro>
              <template v-if="order.status === 'failed'">付款沒有成功，<br>再試一次吧。</template>
              <template v-else>訂單已成立，<br>只差付款這一步。</template>
            </h1>
            <p class="text-ink-soft text-[14.5px] md:text-base leading-[1.9] mt-5 max-w-[540px]" data-intro>
              我們已為你保留本次花材。完成付款後，花藝師會在當日開始修剪與配置，並於 24 小時內出貨。
            </p>
          </div>

          <!-- Payment result banner -->
          <div v-if="paymentResult && paymentMessages[paymentResult] && paymentResult !== 'success'" class="flex items-center gap-3 rounded-xl px-5 py-4 text-sm" :class="paymentMessages[paymentResult].cls" role="status" data-intro>
            <svg class="shrink-0" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16.5v.01"/></svg>
            {{ paymentMessages[paymentResult].text }}
          </div>

          <div class="flex flex-col sm:flex-row gap-3 md:gap-4" data-intro>
            <a :href="'/ecpay/payment/' + order.id" class="btn btn-clay" data-magnetic>{{ order.status === 'failed' ? '重新付款' : '前往付款' }}
              <svg class="btn-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16M14 6l6 6-6 6"/></svg></a>
            <button v-if="order.status === 'pending'" type="button" @click="checkPayment" :disabled="paying" class="btn btn-outline">
              <svg :class="{ 'animate-spin': paying }" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12a8 8 0 1 1-2.3-5.6M20 4v4h-4"/></svg>
              {{ paying ? '查詢中…' : '查詢付款狀態' }}
            </button>
          </div>

          <p v-if="order.status === 'pending'" class="flex items-center gap-3.5 bg-blush text-clay-dark rounded-xl px-5 py-4 text-[13.5px] leading-[1.7]" data-intro>
            <svg class="shrink-0" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
            若已於綠界完成付款，點擊「查詢付款狀態」即可更新訂單。
          </p>

          <div data-reveal>
            <h2 class="font-serif font-medium text-lg md:text-xl mb-1">收件資訊</h2>
            <dl class="text-[14.5px]">
              <div v-for="row in recipientRows" :key="row.k" class="flex items-start gap-4 py-4 border-b border-line">
                <svg class="shrink-0 mt-0.5 text-ink-soft" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" v-html="row.icon"></svg>
                <dt class="w-20 shrink-0 text-[13px] text-ink-muted pt-px">{{ row.k }}</dt>
                <dd class="break-all">{{ row.v }}</dd>
              </div>
            </dl>
          </div>
        </div>

        <div class="lg:sticky lg:top-28" data-intro><%- include('../partials/receipt') %></div>
      </div>
    </section>
  </template>
</div>
