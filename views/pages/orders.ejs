<div id="app">
  <section class="container-x pt-8 md:pt-14 pb-8 md:pb-12" data-intro>
    <p class="display-italic text-[22px] md:text-[26px] text-clay">My Orders</p>
    <h1 class="font-serif font-medium text-[34px] md:text-[52px] mt-1 md:mt-3">我的訂單</h1>
  </section>

  <div class="container-x pb-24 md:pb-36">
    <div v-if="loading" class="space-y-4"><div v-for="n in 3" :key="n" class="h-24 rounded-xl skeleton"></div></div>

    <div v-else-if="orders.length === 0" class="text-center py-10">
      <div class="w-44 h-56 arch bg-linen mx-auto mb-9 grid place-items-center display-italic text-3xl text-ink-muted">empty</div>
      <h2 class="font-serif text-2xl">還沒有訂單</h2>
      <p class="text-ink-muted text-sm mt-2 mb-8">第一束花，從這裡開始。</p>
      <a href="/#products" class="btn btn-ink">去逛逛</a>
    </div>

    <ul v-else class="border-t border-line">
      <li v-for="order in orders" :key="order.id" data-reveal>
        <a :href="'/orders/' + order.id" class="group grid grid-cols-[1fr_auto] md:grid-cols-[1.4fr_1fr_1fr_auto] items-center gap-x-6 gap-y-3 py-6 md:py-7 border-b border-line hover:bg-card/70 transition-colors md:px-4 md:-mx-4 rounded-sm">
          <div>
            <p class="text-xs text-ink-muted">訂單編號</p>
            <p class="font-label font-semibold mt-1 break-all">{{ order.order_no }}</p>
          </div>
          <p class="hidden md:block font-label text-sm text-ink-soft">{{ new Date(order.created_at).toLocaleDateString('zh-TW') }}</p>
          <p class="font-label font-semibold text-right md:text-left">NT$ {{ order.total_amount.toLocaleString() }}</p>
          <div class="col-span-2 md:col-span-1 flex items-center justify-between md:justify-end gap-6">
            <span class="pill" :class="statusMap[order.status]?.cls || 'pill-pending'">{{ statusMap[order.status]?.label || order.status }}</span>
            <svg class="transition-transform duration-500 group-hover:translate-x-1.5" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16M14 6l6 6-6 6"/></svg>
          </div>
        </a>
      </li>
    </ul>
  </div>
</div>
