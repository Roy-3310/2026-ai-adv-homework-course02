<div id="app">
  <section class="container-x pt-8 md:pt-14 pb-8 md:pb-12 flex flex-col-reverse md:flex-row md:items-end md:justify-between gap-6">
    <div data-intro>
      <p class="display-italic text-[22px] md:text-[26px] text-clay">Your Bag</p>
      <h1 class="font-serif font-medium text-[34px] md:text-[52px] mt-1 md:mt-3">購物車</h1>
    </div>
    <div data-intro><%- include('../partials/stepper') %></div>
  </section>

  <div v-if="loading" class="container-x pb-32 grid lg:grid-cols-[1fr_440px] gap-8 lg:gap-16">
    <div class="space-y-4"><div v-for="n in 3" :key="n" class="h-28 rounded-xl skeleton"></div></div>
    <div class="h-80 rounded-2xl skeleton"></div>
  </div>

  <div v-else-if="items.length === 0" class="container-x pb-32 pt-6 text-center">
    <div class="w-44 h-56 arch bg-linen mx-auto mb-9 grid place-items-center overflow-hidden">
      <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#8E8A80" stroke-width="1" stroke-linejoin="round"><path d="M5 8h14l-1.2 12H6.2L5 8z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8"/></svg>
    </div>
    <h2 class="font-serif text-2xl">購物車還是空的</h2>
    <p class="text-ink-muted text-sm mt-2 mb-8">挑一束喜歡的花，讓今天多一點顏色。</p>
    <a href="/#products" class="btn btn-ink" data-magnetic>去逛逛
      <svg class="btn-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16M14 6l6 6-6 6"/></svg></a>
  </div>

  <div v-else class="container-x pb-24 md:pb-36 grid lg:grid-cols-[1fr_440px] gap-8 lg:gap-16 items-start">
    <div>
      <!-- Free shipping progress -->
      <div class="mb-6 md:mb-8" data-intro>
        <p class="text-sm mb-3" :class="total >= 500 ? 'text-moss' : 'text-ink-soft'">
          <template v-if="total >= 500">✓ 已達免運門檻，這次運費由我們招待。</template>
          <template v-else>再買 <span class="font-label font-bold text-clay">NT$ {{ (500 - total).toLocaleString() }}</span> 即可享免運</template>
        </p>
        <div class="h-[3px] bg-line rounded-full overflow-hidden"><div class="h-full progress-bar rounded-full" :class="total >= 500 ? 'bg-moss' : 'bg-clay'" :style="{ width: Math.min(100, total / 5) + '%' }"></div></div>
      </div>

      <transition-group tag="ul" name="cart-row" class="border-t border-line">
        <li v-for="item in items" :key="item.id" class="flex gap-4 md:gap-6 py-5 md:py-6 border-b border-line">
          <a :href="'/products/' + item.product.id" class="shrink-0 w-20 h-[100px] md:w-24 md:h-[120px] rounded-md overflow-hidden bg-linen">
            <img :src="item.product.image_url || fallbackImage" :alt="item.product.name" class="w-full h-full object-cover">
          </a>
          <div class="flex-1 min-w-0 flex flex-col justify-between gap-3">
            <div class="flex justify-between gap-4">
              <div class="min-w-0">
                <a :href="'/products/' + item.product.id" class="font-serif font-medium md:text-lg hover:text-clay transition-colors">{{ item.product.name }}</a>
                <p class="font-label font-medium text-xs text-ink-muted mt-1">NT$ {{ item.product.price.toLocaleString() }} / 件</p>
              </div>
              <p class="font-label font-semibold whitespace-nowrap">NT$ {{ (item.product.price * item.quantity).toLocaleString() }}</p>
            </div>
            <div class="flex items-center justify-between">
              <div class="qty qty-sm">
                <button type="button" @click="updateQuantity(item.id, item.quantity - 1)" :disabled="item.quantity <= 1" aria-label="減少數量"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M5 12h14"/></svg></button>
                <span class="w-8 text-center num text-lg">{{ item.quantity }}</span>
                <button type="button" @click="updateQuantity(item.id, item.quantity + 1)" :disabled="item.quantity >= item.product.stock" aria-label="增加數量"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></button>
              </div>
              <button type="button" @click="confirmDelete(item.id)" class="text-[13px] text-ink-muted hover:text-clay transition-colors link-underline">移除</button>
            </div>
          </div>
        </li>
      </transition-group>
    </div>

    <aside class="bg-linen rounded-2xl p-6 md:p-9 lg:sticky lg:top-28" data-intro>
      <h2 class="font-serif font-medium text-[22px] mb-5">訂單摘要</h2>
      <dl class="space-y-3 text-sm">
        <div class="flex justify-between"><dt class="text-ink-soft">商品小計</dt><dd class="font-label font-semibold">NT$ {{ total.toLocaleString() }}</dd></div>
        <div class="flex justify-between"><dt class="text-ink-soft">運費</dt><dd class="font-label font-semibold" :class="total >= 500 ? 'text-moss' : ''">{{ total >= 500 ? '免運' : 'NT$ 150' }}</dd></div>
      </dl>
      <div class="flex justify-between items-baseline pt-5 mt-5 border-t border-line">
        <span class="font-serif font-medium text-lg">總計</span>
        <span><span class="font-label font-semibold text-[13px] text-ink-soft mr-1.5">NT$</span><span class="num text-[44px] leading-none">{{ (total + (total >= 500 ? 0 : 150)).toLocaleString() }}</span></span>
      </div>
      <button type="button" @click="goCheckout" class="btn btn-ink w-full mt-6" data-magnetic>前往結帳
        <svg class="btn-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16M14 6l6 6-6 6"/></svg></button>
      <a href="/#products" class="block text-center text-sm text-ink-soft mt-5 hover:text-ink">繼續選購</a>
    </aside>
  </div>

  <!-- Confirm dialog -->
  <transition name="modal">
    <div v-if="confirmVisible" class="fixed inset-0 z-[95] flex items-end sm:items-center justify-center" role="dialog" aria-modal="true" aria-labelledby="confirm-title">
      <div class="absolute inset-0 bg-ink/45 backdrop-blur-sm" @click="confirmVisible = false"></div>
      <div class="modal-panel relative bg-card w-full sm:max-w-sm rounded-t-3xl sm:rounded-3xl p-8 text-center">
        <h3 id="confirm-title" class="font-serif text-xl mb-2">從購物車移除？</h3>
        <p class="text-ink-soft text-sm mb-7">這束花會從你的購物車中移除。</p>
        <div class="grid grid-cols-2 gap-3">
          <button type="button" @click="confirmVisible = false" class="btn btn-outline btn-sm">保留</button>
          <button type="button" @click="handleDelete" class="btn btn-clay btn-sm">確認移除</button>
        </div>
      </div>
    </div>
  </transition>
</div>
