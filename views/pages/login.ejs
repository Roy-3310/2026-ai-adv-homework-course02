<div id="app" class="container-x py-10 md:py-16">
  <div class="grid lg:grid-cols-2 gap-12 lg:gap-24 items-center max-w-[1180px] mx-auto">
    <!-- Art -->
    <div class="relative hidden lg:block" data-intro>
      <div class="aspect-[5/6] arch bg-linen">
        <img src="https://images.unsplash.com/photo-1455659817273-f96807779a8a?w=1000&q=80" alt="花束" class="w-full h-full object-cover">
      </div>
      <div class="absolute -right-8 bottom-12 bg-card rounded-2xl px-6 py-5 shadow-[0_24px_60px_-24px_rgba(30,38,32,.35)] max-w-[260px]">
        <p class="display-italic text-[26px] leading-tight">Welcome back.</p>
        <p class="text-xs text-ink-soft mt-2 leading-relaxed">登入後即可結帳、查詢訂單與付款狀態。</p>
      </div>
    </div>

    <!-- Form -->
    <div class="w-full max-w-[460px] mx-auto lg:mx-0">
      <div data-intro>
        <p class="eyebrow">Member</p>
        <h1 class="font-serif font-medium text-[34px] md:text-5xl mt-4">{{ activeTab === 'login' ? '歡迎回來' : '成為花漾會員' }}</h1>
        <p class="text-ink-soft mt-3 text-[15px]">{{ activeTab === 'login' ? '登入你的帳號，繼續挑選喜歡的花。' : '只需要一分鐘，就能開始收花的日子。' }}</p>
      </div>

      <div class="relative grid grid-cols-2 mt-9 mb-8 p-1 rounded-full border border-line bg-card" role="tablist" data-intro>
        <span class="absolute top-1 bottom-1 left-1 w-[calc(50%-4px)] rounded-full bg-ink transition-transform duration-500 ease-[cubic-bezier(.22,1,.36,1)]" :style="{ transform: activeTab === 'register' ? 'translateX(100%)' : 'translateX(0)' }" aria-hidden="true"></span>
        <button type="button" role="tab" :aria-selected="activeTab === 'login'" @click="activeTab = 'login'; errors = {}" class="relative z-10 py-2.5 text-sm font-medium transition-colors duration-500" :class="activeTab === 'login' ? 'text-paper' : 'text-ink-soft'">登入</button>
        <button type="button" role="tab" :aria-selected="activeTab === 'register'" @click="activeTab = 'register'; errors = {}" class="relative z-10 py-2.5 text-sm font-medium transition-colors duration-500" :class="activeTab === 'register' ? 'text-paper' : 'text-ink-soft'">註冊</button>
      </div>

      <form v-if="activeTab === 'login'" @submit.prevent="handleLogin" class="space-y-5" novalidate>
        <div>
          <label for="login-email" class="field-label">Email</label>
          <input id="login-email" v-model="loginForm.email" type="email" autocomplete="email" placeholder="name@example.com" class="field-input" :class="{ 'is-error': errors.email }">
          <p v-if="errors.email" class="field-error">{{ errors.email }}</p>
        </div>
        <div>
          <label for="login-password" class="field-label">密碼</label>
          <input id="login-password" v-model="loginForm.password" type="password" autocomplete="current-password" placeholder="請輸入密碼" class="field-input" :class="{ 'is-error': errors.password }">
          <p v-if="errors.password" class="field-error">{{ errors.password }}</p>
        </div>
        <button type="submit" :disabled="submitting" class="btn btn-ink w-full mt-8" data-magnetic>
          {{ submitting ? '登入中…' : '登入' }}
          <svg v-if="!submitting" class="btn-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16M14 6l6 6-6 6"/></svg>
        </button>
      </form>

      <form v-else @submit.prevent="handleRegister" class="space-y-5" novalidate>
        <div>
          <label for="reg-name" class="field-label">姓名</label>
          <input id="reg-name" v-model="registerForm.name" type="text" autocomplete="name" placeholder="請輸入姓名" class="field-input" :class="{ 'is-error': errors.name }">
          <p v-if="errors.name" class="field-error">{{ errors.name }}</p>
        </div>
        <div>
          <label for="reg-email" class="field-label">Email</label>
          <input id="reg-email" v-model="registerForm.email" type="email" autocomplete="email" placeholder="name@example.com" class="field-input" :class="{ 'is-error': errors.email }">
          <p v-if="errors.email" class="field-error">{{ errors.email }}</p>
        </div>
        <div>
          <label for="reg-password" class="field-label">密碼</label>
          <input id="reg-password" v-model="registerForm.password" type="password" autocomplete="new-password" placeholder="至少 6 個字元" class="field-input" :class="{ 'is-error': errors.password }">
          <p v-if="errors.password" class="field-error">{{ errors.password }}</p>
        </div>
        <button type="submit" :disabled="submitting" class="btn btn-clay w-full mt-8" data-magnetic>
          {{ submitting ? '註冊中…' : '建立帳號' }}
        </button>
      </form>
    </div>
  </div>
</div>
